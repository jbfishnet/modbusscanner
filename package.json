{
  "name": "modbusscanner",
  "version": "1.0.0",
  "description": "Modbus TCP register scanner with web UI, SQLite data persistence, and real-time monitoring",
  "main": "electron/main.js",
  "author": "Jan-Boike Fish <fishbeef@gmail.com>",
  "scripts": {
    "start": "node server-with-persistence.js",
    "test": "node tests.js",
    "test:integration": "node integration-test.js",
    "test:ui": "playwright test tests/ui.spec.js --reporter=line",
    "test:all": "npm test && npm run test:integration && npm run test:ui",
    "dev": "node server-with-persistence.js",
    "electron": "electron .",
    "electron:rebuild": "electron-rebuild -f -w sqlite3",
    "dist": "electron-builder"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "modbus-serial": "^8.0.16",
    "sqlite3": "^5.1.6",
    "uplot": "^1.6.32",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.jbfishnet.modbusscanner",
    "productName": "Modbus Scanner",
    "files": [
      "electron/**/*",
      "src/**/*",
      "web/**/*",
      "server-with-persistence.js",
      "datastore.js",
      "index.html",
      "modbus.yaml",
      "package.json"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "resources/icon.ico"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "jbfishnet",
      "repo": "modbusscanner"
    }
  }
}
